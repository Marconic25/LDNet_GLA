#!/bin/bash
#PBS -N ldnet_gla_clean
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=0
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /work/u10677113/ldnet_clean.log

export APPTAINER_TMPDIR=/work/u10677113/apptainer_tmp
export APPTAINER_CACHEDIR=/work/u10677113/apptainer_tmp

REPO=/work/u10677113/LDNet_GLA

apptainer exec --writable-tmpfs \
    --env PYTHONPATH=$REPO/clean \
    --bind /work/u10677113:/work/u10677113 \
    /work/u10677113/tensorflow_gpu.sif \
    bash -c "pip install matplotlib scipy -q && python3 $REPO/clean/run.py \
        --model-dir $REPO/clean/models/latent_10 \
        --warmup-csv /work/u10677113/NACA2312/dataset_v5/sim_A_000_train/structural_trajectory.csv"
