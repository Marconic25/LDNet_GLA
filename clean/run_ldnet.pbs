#!/bin/bash
#PBS -N ldnet_gla_clean
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=0
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /work/u10677113/ldnet_clean.log

export APPTAINER_TMPDIR=/work/u10677113/apptainer_tmp
export APPTAINER_CACHEDIR=/work/u10677113/apptainer_tmp

# Path to trained LDNet weights (latent_dim=10)
WEIGHTS=/work/u10677113/LDNet_GLA/results/sensitivity/latent_10

# Repo root on the cluster
REPO=/work/u10677113/LDNet_OF

apptainer exec --writable-tmpfs --bind /work/u10677113:/work/u10677113 \
    /work/u10677113/tensorflow_gpu.sif \
    bash -c "
        set -e
        pip install scipy matplotlib -q
        cd $REPO/clean
        python run.py --model-dir $WEIGHTS
    "
