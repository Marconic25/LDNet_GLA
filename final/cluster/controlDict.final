FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// controlDict OWNED by the v6 dataset campaign (final/cluster + final/data).
// NEW numerics vs the recon field-extraction campaign (recon/cluster/controlDict.
// extract): deltaT 7e-5 -> 3.16e-05, maxCo 2 -> 1, coupling window 50 -> 29
// (window size is a cosim_driver_final.py CLI arg, not set here). purgeWrite 0 so
// every window's field write survives long enough for cosim_driver_final.py's
// INCREMENTAL reconstructPar+extract+purge to consume it before the next window
// starts -- unlike the recon campaign, this driver never lets more than a
// field-every cadence's worth of root time dirs accumulate (see cosim_driver_
// final.py's --field-every / incremental-extract design note), so purgeWrite
// itself is not what bounds disk usage here; it just must not race the
// reconstruct-then-delete step by purging a dir out from under it.
// Independent of the shared cosim_main controlDict (which other campaigns
// mutate). cosim_driver_final.py rewrites startFrom/startTime/stopAt/endTime/
// writeInterval in place per window and PRESERVES purgeWrite, so 0 holds for
// the whole run.

application     pimpleFoam;

startFrom       latestTime;
startTime       5.9992800000e+00;
stopAt          endTime;
endTime         5.9997800000e+00;

deltaT          3.16e-05;

writeControl    timeStep;
writeInterval   7;

purgeWrite      0;
writeFormat     binary;
writePrecision  10;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

adjustTimeStep  no;
maxCo           1;

libs
(
    "libfvMotionSolvers.so"
);

functions
{
    forces
    {
        type                forces;
        libs                ("libforces.so");
        writeControl        timeStep;
        writeInterval       5;
        patches             (wing_main flap);
        rho                 rhoInf;
        log                 true;
        rhoInf              1.225;
        CofR                (0.40 0.0 0.125);
    }

    forceCoeffs
    {
        type                forceCoeffs;
        libs                ("libforces.so");
        writeControl        timeStep;
        writeInterval       5;
        patches             (wing_main flap);
        rho                 rhoInf;
        log                 true;
        rhoInf              1.225;
        magUInf             80;
        lRef                1;
        Aref                0.05;
        CofR                (0.40 0.0 0.125);
        liftDir             (0 1 0);
        dragDir             (1 0 0);
        pitchAxis           (0 0 1);
    }
}

// ************************************************************************* //
