#!/bin/bash
#PBS -N coral3
#PBS -q cpu
#PBS -l select=1:ncpus=8
#PBS -l walltime=24:00:00
#PBS -j oe
#
# D-RES lever (post arm-A): mean-split + shift-modulated SIREN decoder (CORAL),
# omega0 sweep. qsub -v ARM=ms_coral,SEED=<int>,OMEGA=<w0> (OMEGA like 10/30/60).
# Everything else = the M-SPLIT protocol (d_s=1, restarts 2, adam 300, bfgs 2000,
# log-every 1). No Fourier features (SIREN sine activations ARE the spectral-bias
# remedy; --decoder coral forbids --fourier-scales). Latent ODE unchanged.
: "${SEED:?pass -v ARM=ms_coral,SEED=<int>,OMEGA=<w0>}"
: "${OMEGA:?pass -v OMEGA=<siren omega0, e.g. 10/30/60>}"
export APPTAINER_TMPDIR=/work/u10677113/apptainer_tmp
export APPTAINER_CACHEDIR=/work/u10677113/apptainer_tmp
RECON=/work/u10677113/NACA2312/recon
# dir = coral_o{OMEGA}_s{seed}; dumps use the ms_{arm} convention so
# meansplit_compare.py (regex (.+)_s(\d+) then results/ms_{arm}_...) picks them up.
OUT=models/meansplit_study/coral_o${OMEGA}_s${SEED}

echo "=== coral3 omega0=$OMEGA SEED=$SEED start $(date) ==="
hostname
apptainer exec --writable-tmpfs --bind /work/u10677113:/work/u10677113 \
    /work/u10677113/tensorflow_gpu.sif \
    bash -c "pip install -q h5py scipy matplotlib pandas 2>/dev/null; cd $RECON; \
      mkdir -p $OUT; \
      python3 -u train_fields.py --train data/FIELDS_div_train.h5 \
        --valid data/FIELDS_div_valid.h5 --test data/FIELDS_Cc060.h5 \
        --out $OUT --latents 1 \
        --adam 300 --bfgs 2000 --restarts 2 --output-nl linear --log-every 1 \
        --seed-base $SEED --mean-split --decoder coral --siren-omega0 $OMEGA \
        > $OUT/train.log 2>&1; \
      python3 -u reconstruct_fields.py --model $OUT/latent_1 \
        --data data/FIELDS_A025.h5 --index 0 --name sim_A_025 \
        --out results/ms_coral_o${OMEGA}_s${SEED}_rom_a025 > $OUT/recon.log 2>&1; \
      python3 -u reconstruct_fields.py --model $OUT/latent_1 \
        --data data/FIELDS_Cc060.h5 --index 0 --name sim_Cc_060 \
        --out results/ms_coral_o${OMEGA}_s${SEED}_rom_cc060 >> $OUT/recon.log 2>&1; \
      echo CORAL3_o${OMEGA}_s${SEED}_DONE"
echo "=== coral3 omega0=$OMEGA SEED=$SEED end $(date) exit $? ==="
