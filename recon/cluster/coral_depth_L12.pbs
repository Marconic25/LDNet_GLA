#!/bin/bash
#PBS -N coral_L12
#PBS -q cpu
#PBS -l select=1:ncpus=8
#PBS -l walltime=24:00:00
#PBS -j oe
#
# Self-improving-loop Tier 1: combine the two independently-validated winning
# levers that were never run together. Depth (L12: dyn=4x7, rec=8x24 -- the
# safest deep rung per DEPTH_STUDY_NOTES, chosen over L24 which is known to
# seed-lottery collapse, e.g. L24_ds1_s0=1.670e-2 vs L24_ds1_s100=1.227e-2)
# and mean-split + CORAL shift-modulated SIREN omega0=10 (D-RES CLOSED winner,
# 2026-07-27). Protocol otherwise identical to coral3.pbs/meansplit.pbs so
# meansplit_compare.py picks the dumps up unchanged (arm=coral_o10_L12).
# qsub -v SEED=<int> (use 0/100/200 for n=3, matching project convention).
: "${SEED:?pass -v SEED=<int>}"
export APPTAINER_TMPDIR=/work/u10677113/apptainer_tmp
export APPTAINER_CACHEDIR=/work/u10677113/apptainer_tmp
RECON=/work/u10677113/NACA2312/recon
OUT=models/meansplit_study/coral_o10_L12_s${SEED}

echo "=== coral_L12 SEED=$SEED start $(date) ==="
hostname
apptainer exec --writable-tmpfs --bind /work/u10677113:/work/u10677113 \
    /work/u10677113/tensorflow_gpu.sif \
    bash -c "pip install -q h5py scipy matplotlib pandas 2>/dev/null; cd $RECON; \
      mkdir -p $OUT; \
      python3 -u train_fields.py --train data/FIELDS_div_train.h5 \
        --valid data/FIELDS_div_valid.h5 --test data/FIELDS_Cc060.h5 \
        --out $OUT --latents 1 \
        --dyn-layers 4 --dyn-width 7 --rec-layers 8 --rec-width 24 \
        --adam 300 --bfgs 2000 --restarts 2 --output-nl linear --log-every 1 \
        --seed-base $SEED --mean-split --decoder coral --siren-omega0 10 \
        > $OUT/train.log 2>&1; \
      python3 -u reconstruct_fields.py --model $OUT/latent_1 \
        --data data/FIELDS_A025.h5 --index 0 --name sim_A_025 \
        --out results/ms_coral_o10_L12_s${SEED}_rom_a025 > $OUT/recon.log 2>&1; \
      python3 -u reconstruct_fields.py --model $OUT/latent_1 \
        --data data/FIELDS_Cc060.h5 --index 0 --name sim_Cc_060 \
        --out results/ms_coral_o10_L12_s${SEED}_rom_cc060 >> $OUT/recon.log 2>&1; \
      echo CORAL_L12_s${SEED}_DONE"
echo "=== coral_L12 SEED=$SEED end $(date) exit $? ==="
