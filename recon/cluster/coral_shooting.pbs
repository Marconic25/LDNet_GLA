#!/bin/bash
#PBS -N coral_shoot
#PBS -q cpu
#PBS -l select=1:ncpus=8
#PBS -l walltime=24:00:00
#PBS -j oe
#
# NNdyn/latent-ODE lever (from LATENTODE_LITERATURE_NOTES.md, item 5): multiple
# shooting on top of the established champion (mean-split + CORAL o10, d_s=1,
# L6). K=4 segments fixed, sweeping the continuity-penalty weight lambda.
# qsub -v LAMBDA=<float> (use 0.1/1.0/10.0). Single seed each (diagnostic,
# like the R4/omega0 sweeps): this is the first test of the idea, replicate
# with more seeds only if a lambda shows a real effect.
: "${LAMBDA:?pass -v LAMBDA=<float>, e.g. 0.1, 1.0, or 10.0}"
export APPTAINER_TMPDIR=/work/u10677113/apptainer_tmp
export APPTAINER_CACHEDIR=/work/u10677113/apptainer_tmp
RECON=/work/u10677113/NACA2312/recon
OUT=models/meansplit_study/coral_o10_shootK4L${LAMBDA}_s0

echo "=== coral_shooting LAMBDA=$LAMBDA start $(date) ==="
hostname
apptainer exec --writable-tmpfs --bind /work/u10677113:/work/u10677113 \
    /work/u10677113/tensorflow_gpu.sif \
    bash -c "pip install -q h5py scipy matplotlib pandas 2>/dev/null; cd $RECON; \
      mkdir -p $OUT; \
      python3 -u train_fields.py --train data/FIELDS_div_train.h5 \
        --valid data/FIELDS_div_valid.h5 --test data/FIELDS_Cc060.h5 \
        --out $OUT --latents 1 \
        --adam 300 --bfgs 2000 --restarts 2 --output-nl linear --log-every 1 \
        --seed-base 0 --mean-split --decoder coral --siren-omega0 10 \
        --shooting-segments 4 --shooting-lambda $LAMBDA \
        > $OUT/train.log 2>&1; \
      python3 -u reconstruct_fields.py --model $OUT/latent_1 \
        --data data/FIELDS_A025.h5 --index 0 --name sim_A_025 \
        --out results/ms_coral_o10_shootK4L${LAMBDA}_s0_rom_a025 > $OUT/recon.log 2>&1; \
      python3 -u reconstruct_fields.py --model $OUT/latent_1 \
        --data data/FIELDS_Cc060.h5 --index 0 --name sim_Cc_060 \
        --out results/ms_coral_o10_shootK4L${LAMBDA}_s0_rom_cc060 >> $OUT/recon.log 2>&1; \
      echo CORAL_SHOOTK4L${LAMBDA}_s0_DONE"
echo "=== coral_shooting LAMBDA=$LAMBDA end $(date) exit $? ==="
