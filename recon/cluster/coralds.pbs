#!/bin/bash
#PBS -N coralds
#PBS -q cpu
#PBS -l select=1:ncpus=8
#PBS -l walltime=24:00:00
#PBS -j oe
#
# D-RES arm A: coral (winning omega0=10, shift) + latent-state sweep. Tests whether
# the decoder fix unblocked latent scaling (was d_s=1 optimal only because the tanh
# decoder was the bottleneck?). qsub -v ARM=ms_coral,SEED=<int>,DS=<latent dim>.
# d_s=1 already exists as coral_o10; sweep DS in {2,3,5}. Recon from latent_${DS}.
: "${SEED:?pass -v SEED=<int>,DS=<latent dim>}"
: "${DS:?pass -v DS=<latent dim, e.g. 2/3/5>}"
export APPTAINER_TMPDIR=/work/u10677113/apptainer_tmp
export APPTAINER_CACHEDIR=/work/u10677113/apptainer_tmp
RECON=/work/u10677113/NACA2312/recon
OUT=models/meansplit_study/coral_ds${DS}_s${SEED}

echo "=== coralds d_s=$DS SEED=$SEED start $(date) ==="
hostname
apptainer exec --writable-tmpfs --bind /work/u10677113:/work/u10677113 \
    /work/u10677113/tensorflow_gpu.sif \
    bash -c "pip install -q h5py scipy matplotlib pandas 2>/dev/null; cd $RECON; \
      mkdir -p $OUT; \
      python3 -u train_fields.py --train data/FIELDS_div_train.h5 \
        --valid data/FIELDS_div_valid.h5 --test data/FIELDS_Cc060.h5 \
        --out $OUT --latents $DS \
        --adam 300 --bfgs 2000 --restarts 2 --output-nl linear --log-every 1 \
        --seed-base $SEED --mean-split --decoder coral --siren-omega0 10 \
        > $OUT/train.log 2>&1; \
      python3 -u reconstruct_fields.py --model $OUT/latent_${DS} \
        --data data/FIELDS_A025.h5 --index 0 --name sim_A_025 \
        --out results/ms_coral_ds${DS}_s${SEED}_rom_a025 > $OUT/recon.log 2>&1; \
      python3 -u reconstruct_fields.py --model $OUT/latent_${DS} \
        --data data/FIELDS_Cc060.h5 --index 0 --name sim_Cc_060 \
        --out results/ms_coral_ds${DS}_s${SEED}_rom_cc060 >> $OUT/recon.log 2>&1; \
      echo CORALDS_ds${DS}_s${SEED}_DONE"
echo "=== coralds d_s=$DS SEED=$SEED end $(date) exit $? ==="
