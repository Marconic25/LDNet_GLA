#!/bin/bash
#PBS -N depthrepl
#PBS -q cpu
#PBS -l select=1:ncpus=8:mem=64gb
#PBS -l walltime=48:00:00
#PBS -j oe
#
# Seed replication of a depth-study cell (-v DS=<latent>,SEED=<seed-base>).
# Exact depth-study protocol (L24: dyn 8x7, rec 16x24; restarts=2, adam=300,
# bfgs=4000, linear) but a different RNG seed family -> independent draw for
# error bars on the L24 ds10-beats-ds1 flip. Output outside the depth_study
# index tree: models/depth_replication/L24_ds<DS>_s<SEED>/.

: "${DS:?pass -v DS=<latent>,SEED=<seed-base>}"
: "${SEED:?pass -v DS=<latent>,SEED=<seed-base>}"
export APPTAINER_TMPDIR=/work/u10677113/apptainer_tmp
export APPTAINER_CACHEDIR=/work/u10677113/apptainer_tmp
RECON=/work/u10677113/NACA2312/recon
OUT=models/depth_replication/L24_ds${DS}_s${SEED}

echo "=== depthrepl L24 ds=$DS seed=$SEED start $(date) ==="
hostname
apptainer exec --writable-tmpfs --bind /work/u10677113:/work/u10677113 \
    /work/u10677113/tensorflow_gpu.sif \
    bash -c "pip install -q h5py scipy matplotlib pandas 2>/dev/null; cd $RECON; \
      mkdir -p $OUT; \
      python3 -u train_fields.py --train data/FIELDS_div_train.h5 \
        --valid data/FIELDS_div_valid.h5 --test data/FIELDS_Cc060.h5 \
        --out $OUT --latents $DS --dyn-layers 8 --rec-layers 16 \
        --adam 300 --bfgs 4000 --restarts 2 --seed-base $SEED \
        --output-nl linear --log-every 1 > $OUT/train.log 2>&1; \
      echo DEPTHREPL_DS${DS}_S${SEED}_DONE"
echo "=== depthrepl ds=$DS end $(date) exit $? ==="
