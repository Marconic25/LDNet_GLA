#!/bin/bash
#PBS -N msplit
#PBS -q cpu
#PBS -l select=1:ncpus=8
#PBS -l walltime=24:00:00
#PBS -j oe
#
# M-SPLIT study: one (ARM, SEED) run. qsub -v ARM=<base|ms>,SEED=<int>
# Protocol identical to final_div (d_s=1, output-nl linear, restarts 2, adam 300,
# bfgs 2000) except --seed-base and, for ARM=ms, --mean-split (decoder learns
# fluctuations around the stored train-mean field; targets the static near-wall
# bias, ~90% of the BL vx error). After training, dumps full-grid reconstructions
# of the two eval sims for the static/dynamic x region comparison
# (analysis/meansplit_compare.py).
: "${ARM:?pass -v ARM=<base|ms>,SEED=<int>}"
: "${SEED:?pass -v ARM=<base|ms>,SEED=<int>}"
export APPTAINER_TMPDIR=/work/u10677113/apptainer_tmp
export APPTAINER_CACHEDIR=/work/u10677113/apptainer_tmp
RECON=/work/u10677113/NACA2312/recon
OUT=models/meansplit_study/${ARM}_s${SEED}
MSFLAG=""
[ "$ARM" = "ms" ] && MSFLAG="--mean-split"

echo "=== msplit ARM=$ARM SEED=$SEED start $(date) ==="
hostname
apptainer exec --writable-tmpfs --bind /work/u10677113:/work/u10677113 \
    /work/u10677113/tensorflow_gpu.sif \
    bash -c "pip install -q h5py scipy matplotlib pandas 2>/dev/null; cd $RECON; \
      mkdir -p $OUT; \
      python3 -u train_fields.py --train data/FIELDS_div_train.h5 \
        --valid data/FIELDS_div_valid.h5 --test data/FIELDS_Cc060.h5 \
        --out $OUT --latents 1 \
        --adam 300 --bfgs 2000 --restarts 2 --output-nl linear --log-every 1 \
        --seed-base $SEED $MSFLAG \
        > $OUT/train.log 2>&1; \
      python3 -u reconstruct_fields.py --model $OUT/latent_1 \
        --data data/FIELDS_A025.h5 --index 0 --name sim_A_025 \
        --out results/ms_${ARM}_s${SEED}_rom_a025 > $OUT/recon.log 2>&1; \
      python3 -u reconstruct_fields.py --model $OUT/latent_1 \
        --data data/FIELDS_Cc060.h5 --index 0 --name sim_Cc_060 \
        --out results/ms_${ARM}_s${SEED}_rom_cc060 >> $OUT/recon.log 2>&1; \
      echo MSPLIT_${ARM}_s${SEED}_DONE"
echo "=== msplit ARM=$ARM SEED=$SEED end $(date) exit $? ==="
