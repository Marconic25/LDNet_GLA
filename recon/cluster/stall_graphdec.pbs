#!/bin/bash
#PBS -N stall_graph
#PBS -q cpu
#PBS -l select=1:ncpus=8
#PBS -l walltime=48:00:00
#PBS -j oe
#
# Post-closure literature-driven candidate: --graph-decoder (GraphRelaxDecoder
# -- genuine local mesh-graph message-passing on a fixed ~200-node near-flap
# subgraph, "Read, Write, Relax" arXiv:2608.21677) on top of the champion
# (mean-split + CORAL o10, d_s=1, L6). DYNAMIC_CONTRIBUTION_LITERATURE_NOTES.md
# recommendation B -- the ranked-highest candidate after the DMD diagnostic
# (recommendation A) cheaply ruled out a two-timescale/dual-Koopman split.
# Distinct from lever 10 (--local-decoder, LOST): that head never mixed
# information between points; this one performs real neighbor mixing via
# real mesh connectivity.
# qsub -v SEED=<int> (0/100/200 for n=3; launched ONE AT A TIME per the
# established discipline -- bulk-launching triggered repeated full-preemption
# churn from a concurrent chat sharing this cluster account).
: "${SEED:?pass -v SEED=<int>}"
export APPTAINER_TMPDIR=/work/u10677113/apptainer_tmp
export APPTAINER_CACHEDIR=/work/u10677113/apptainer_tmp
RECON=/work/u10677113/NACA2312/recon
TRI=/work/u10677113/NACA2312/recon_fields/sim_Cc_060_test/mesh_triangles.npy
OUT=models/meansplit_study/coral_o10_graph_s${SEED}

echo "=== stall_graphdec SEED=$SEED start $(date) ==="
hostname
apptainer exec --writable-tmpfs --bind /work/u10677113:/work/u10677113 \
    /work/u10677113/tensorflow_gpu.sif \
    bash -c "pip install -q h5py scipy matplotlib pandas 2>/dev/null; cd $RECON; \
      mkdir -p $OUT; \
      python3 -u train_fields.py --train data/FIELDS_div_train.h5 \
        --valid data/FIELDS_div_valid.h5 --test data/FIELDS_Cc060.h5 \
        --out $OUT --latents 1 \
        --adam 300 --bfgs 2000 --restarts 2 --output-nl linear --log-every 1 \
        --seed-base $SEED --mean-split --decoder coral --siren-omega0 10 \
        --graph-decoder --sampling graph --graph-nodes analysis/graph_nodes.npy \
        --tri $TRI --graph-hidden 16 --graph-relax-steps 2 \
        > $OUT/train.log 2>&1; \
      python3 -u reconstruct_fields.py --model $OUT/latent_1 \
        --data data/FIELDS_A025.h5 --index 0 --name sim_A_025 \
        --out results/ms_coral_o10_graph_s${SEED}_rom_a025 > $OUT/recon.log 2>&1; \
      python3 -u reconstruct_fields.py --model $OUT/latent_1 \
        --data data/FIELDS_Cc060.h5 --index 0 --name sim_Cc_060 \
        --out results/ms_coral_o10_graph_s${SEED}_rom_cc060 >> $OUT/recon.log 2>&1; \
      echo STALL_GRAPH_s${SEED}_DONE"
echo "=== stall_graphdec SEED=$SEED end $(date) exit $? ==="
