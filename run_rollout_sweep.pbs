#!/bin/bash
#PBS -N LDNet_rollsweep
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=16:00:00
#PBS -j oe
#PBS -o /work/u10677113/
#
# Closed-loop ROLLOUT sweep of the LDNet input x latent sensitivity study.
# Runs src/sensitivity_rollout_sweep.py for ONE input configuration, looping
# over the latent sizes {1,3,5,10} INSIDE the job (qsub -v splits on commas,
# so a comma list can never be passed via -v).
#
# Submit (one job per input set; the single GPU serializes them):
#     qsub -v INPUT_SET=2 run_rollout_sweep.pbs
#     qsub -v INPUT_SET=4 run_rollout_sweep.pbs
#     qsub -v INPUT_SET=6 run_rollout_sweep.pbs
#
# Warm-starts are the teacher-forced sweep models under
#   /work/u10677113/LDNet_GLA/results/sensitivity/in${INPUT_SET}/latent_{d}/
# Results land under
#   /work/u10677113/LDNet_GLA/results/sensitivity_rollout/in${INPUT_SET}/latent_{d}/
#
# NOTE: for INPUT_SET=2 the nets see only (delta, W_gust); the structural
# feedback never enters the networks, so closed-loop rollout training
# degenerates to open-loop. in2 is run only for grid completeness.

export APPTAINER_TMPDIR=/work/u10677113/apptainer_tmp
export APPTAINER_CACHEDIR=/work/u10677113/apptainer_tmp

WORKDIR=/work/u10677113/LDNet_GLA
INPUT_SET="${INPUT_SET:-6}"
RESULTS_OVERRIDE="${RESULTS_OVERRIDE:-${WORKDIR}/results/sensitivity_rollout}"
WARMSTART_ROOT="${WARMSTART_ROOT:-${WORKDIR}/results/sensitivity}"
LAMBDA_DAMP="${LAMBDA_DAMP:-0.003}"
ROLLOUT_LEN="${ROLLOUT_LEN:-800}"
NADAM="${NADAM:-0}"
NBFGS="${NBFGS:-500}"
W_LOAD="${W_LOAD:-1.0}"
PATIENCE="${PATIENCE:-20}"

apptainer exec --writable-tmpfs --bind /work/u10677113:/work/u10677113 \
    --env PYTHONPATH=${WORKDIR}/clean \
    /work/u10677113/tensorflow_gpu.sif \
    bash -c "
        pip install scipy matplotlib h5py -q

        echo '========================================'
        echo \"Rollout sweep: INPUT_SET=${INPUT_SET}  latents 1,3,5,10\"
        echo '========================================'
        cd ${WORKDIR}/src
        for D in 1 3 5 10; do
            echo ''
            echo \"--- in${INPUT_SET} / latent_\${D} @ \$(date) ---\"
            INPUT_SET=${INPUT_SET} \
            NUM_LATENT=\${D} \
            LAMBDA_DAMP=${LAMBDA_DAMP} \
            ROLLOUT_LEN=${ROLLOUT_LEN} \
            NADAM=${NADAM} \
            NBFGS=${NBFGS} \
            W_LOAD=${W_LOAD} \
            PATIENCE=${PATIENCE} \
            DATA_OVERRIDE=${WORKDIR}/data \
            WARMSTART_ROOT=${WARMSTART_ROOT} \
            RESULTS_OVERRIDE=${RESULTS_OVERRIDE} \
            OMP_NUM_THREADS=4 TF_NUM_INTRAOP_THREADS=4 TF_NUM_INTEROP_THREADS=2 \
            python3 -u sensitivity_rollout_sweep.py \
                || echo \"[FAILED] in${INPUT_SET}/latent_\${D} — continuing with next\"
        done

        echo ''
        echo \"Done @ \$(date).\"
    "
