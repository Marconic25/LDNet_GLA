#!/bin/bash
#PBS -N LDNet_insweep
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=16:00:00
#PBS -j oe
#PBS -o /work/u10677113/sensitivity_in.log
#
# Number-of-inputs study for the LDNet load-reconstruction accuracy (F_y, M_z).
# Runs src/sensitivity_latent.py for one input configuration and a latent-state sweep.
#
# Submit (one job per input set):
#     qsub -v INPUT_SET=2 run_sensitivity_inputs.pbs
#     qsub -v INPUT_SET=4 run_sensitivity_inputs.pbs
#     qsub -v INPUT_SET=6 run_sensitivity_inputs.pbs      # re-run for uniform traces/loss
#
# If a full {1,3,5,10} sweep exceeds walltime, submit per latent size, e.g.:
#     qsub -v INPUT_SET=2,LATENT_SWEEP=10 run_sensitivity_inputs.pbs
#
# Results land under /work/u10677113/LDNet_GLA/results/sensitivity/in${INPUT_SET}/.
# Pull that tree back locally, then run light/plots_ldnet_accuracy.py to build figures.

export APPTAINER_TMPDIR=/work/u10677113/apptainer_tmp
export APPTAINER_CACHEDIR=/work/u10677113/apptainer_tmp

WORKDIR=/work/u10677113/LDNet_GLA
INPUT_SET="${INPUT_SET:-2}"
LATENT_SWEEP="${LATENT_SWEEP:-1,3,5,10}"
PATIENCE="${PATIENCE:-50}"
RESULTS_OVERRIDE="${RESULTS_OVERRIDE:-${WORKDIR}/results/sensitivity}"
EXPORT_ONLY="${EXPORT_ONLY:-0}"
LAMBDA_DAMP="${LAMBDA_DAMP:-0.0}"
ALPHA_REG="${ALPHA_REG:-0.0}"
FAMILY_W="${FAMILY_W:-0}"

apptainer exec --writable-tmpfs --bind /work/u10677113:/work/u10677113 \
    /work/u10677113/tensorflow_gpu.sif \
    bash -c "
        set -e
        pip install scipy matplotlib h5py -q

        echo '========================================'
        echo \"Input study: INPUT_SET=${INPUT_SET}  LATENT_SWEEP=${LATENT_SWEEP}  PATIENCE=${PATIENCE}\"
        echo '========================================'
        cd ${WORKDIR}/src
        INPUT_SET=${INPUT_SET} \
        LATENT_SWEEP=${LATENT_SWEEP} \
        PATIENCE=${PATIENCE} \
        EXPORT_ONLY=${EXPORT_ONLY} \
        LAMBDA_DAMP=${LAMBDA_DAMP} \
        ALPHA_REG=${ALPHA_REG} \
        FAMILY_W=${FAMILY_W} \
        DATA_OVERRIDE=${WORKDIR}/data \
        RESULTS_OVERRIDE=${RESULTS_OVERRIDE} \
        python3 sensitivity_latent.py

        echo ''
        echo 'Done.'
    "
